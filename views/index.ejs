<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Chess Game — Play Online</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-primary: #312e2b;
      --bg-secondary: #272522;
      --bg-tertiary: #3d3a37;
      --bg-card: #262421;
      --border-color: rgba(255,255,255,0.08);
      --border-light: rgba(255,255,255,0.12);
      --text-primary: #ffffff;
      --text-secondary: #b0b0b0;
      --text-muted: #8c8c8c;
      --accent-green: #81b64c;
      --accent-green-hover: #9bc35c;
      --accent-blue: #5d8aa8;
      --accent-red: #c44536;
      --accent-amber: #e3a02a;
      --square-light: #ebecd0;
      --square-dark: #739552;
      --square-selected: rgba(255,255,0,0.4);
      --square-legal: rgba(129,182,76,0.3);
      --square-lastmove: rgba(255,255,100,0.35);
      --square-check: rgba(196,69,54,0.6);
      --font-heading: 'Montserrat', sans-serif;
      --font-body: 'Inter', sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }

    body {
      background: linear-gradient(160deg, #4a6741 0%, #3d5c50 30%, #2d4a3e 60%, #1e3a2f 100%);
      font-family: var(--font-body);
      color: var(--text-primary);
      overflow: hidden;
    }

    /* Layout */
    .game-container {
      display: flex;
      height: 100vh;
      overflow: hidden;
    }

    .main-area {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px;
      overflow-y: auto;
    }

    .sidebar {
      width: 360px;
      background: var(--bg-secondary);
      border-left: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* Top bar */
    .top-bar {
      background: var(--bg-secondary);
      border-bottom: 1px solid var(--border-color);
      padding: 12px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
    }

    .room-info {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .room-code {
      font-family: var(--font-heading);
      font-size: 14px;
      font-weight: 700;
      color: var(--text-primary);
      background: var(--bg-tertiary);
      padding: 6px 12px;
      border-radius: 6px;
      letter-spacing: 1px;
    }

    .btn-copy {
      padding: 6px 12px;
      background: var(--accent-green);
      color: #fff;
      border: none;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-copy:hover { background: var(--accent-green-hover); }

    /* Player cards */
    .player-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 16px;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .player-card.active {
      border-color: var(--accent-green);
      box-shadow: 0 0 0 2px rgba(129,182,76,0.2);
    }

    .player-info {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .player-avatar {
      width: 40px;
      height: 40px;
      border-radius: 8px;
      background: var(--bg-tertiary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }

    .player-details h3 {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 2px;
    }

    .player-details p {
      font-size: 12px;
      color: var(--text-muted);
    }

    .player-timer {
      font-family: var(--font-heading);
      font-size: 20px;
      font-weight: 700;
      color: var(--text-primary);
    }

    .player-timer.low { color: var(--accent-red); }

    /* Player captured pieces - shown inline inside player card */
    .player-captured-inline {
      display: flex;
      gap: 2px;
      margin-top: 4px;
      min-height: 20px;
      align-items: center;
      flex-wrap: wrap;
    }

    .player-captured-inline:empty {
      display: none;
    }

    .captured-mini {
      font-size: 16px;
      opacity: 0.8;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
    }

    /* Chessboard */
    .board-wrapper {
      max-width: 400px;
      width: 100%;
      margin: 0 auto;
    }

    .board-container {
      position: relative;
      width: 100%;
      padding-bottom: 100%;
      background: var(--bg-card);
      border-radius: 8px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.4);
      overflow: hidden;
    }

    #chessboard {
      position: absolute;
      inset: 0;
      display: grid;
      grid-template-columns: repeat(8, 1fr);
      grid-template-rows: repeat(8, 1fr);
    }

    .square {
      position: relative;
      cursor: pointer;
      transition: background-color 0.15s;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .square.light { background-color: var(--square-light); }
    .square.dark { background-color: var(--square-dark); }
    .square.selected { background-color: var(--square-selected) !important; }
    .square.legal-move::after {
      content: '';
      width: 30%;
      height: 30%;
      background: var(--square-legal);
      border-radius: 50%;
    }
    .square.last-move { background-color: var(--square-lastmove) !important; }
    .square.in-check { background-color: var(--square-check) !important; }

    .piece {
      font-size: clamp(24px, 3.5vw, 48px);
      user-select: none;
      pointer-events: none;
      font-family: "Segoe UI Symbol", "Noto Sans Symbols", serif;
      line-height: 1;
    }

    .piece.white-piece {
      color: #f8f8f8;
      text-shadow: 0 2px 2px rgba(0,0,0,0.45), 0 0 1px #111;
    }

    .piece.black-piece {
      color: #111111;
      text-shadow: 0 1px 1px rgba(255,255,255,0.35);
    }

    /* Sidebar content */
    .sidebar-content {
      flex: 1;
      overflow-y: auto;
      padding: 20px;
    }

    .section-title {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 12px;
    }

    .move-history {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 12px;
      max-height: 200px;
      overflow-y: auto;
      margin-bottom: 20px;
    }

    .move-item {
      padding: 6px 8px;
      font-size: 13px;
      color: var(--text-secondary);
      border-radius: 4px;
      margin-bottom: 4px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .move-item:hover { background: var(--bg-tertiary); }

    .move-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      margin-right: 4px;
    }

    .move-dot-white {
      background: #f0f0f0;
      border: 1px solid #333;
    }

    .move-dot-black {
      background: #1a1a1a;
      border: 1px solid #666;
    }

    /* Capture indicator - shows when piece can be taken */
    .piece-capturable {
      position: relative;
    }

    .piece-capturable::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 44px;
      height: 44px;
      border: 3px solid var(--accent-red);
      border-radius: 50%;
      pointer-events: none;
      animation: pulse-capture 1.2s ease-in-out infinite;
      box-shadow: 0 0 10px rgba(196, 69, 54, 0.5);
    }

    @keyframes pulse-capture {
      0%, 100% { opacity: 0.7; transform: translate(-50%, -50%) scale(1); }
      50% { opacity: 1; transform: translate(-50%, -50%) scale(1.05); }
    }

    /* Chat */
    .chat-container {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      height: 250px;
    }

    .chat-messages {
      flex: 1;
      overflow-y: auto;
      padding: 12px;
    }

    .chat-message {
      margin-bottom: 10px;
      font-size: 13px;
    }

    .chat-message strong {
      color: var(--accent-green);
      font-weight: 600;
    }

    .chat-input-area {
      border-top: 1px solid var(--border-color);
      padding: 10px;
      display: flex;
      gap: 8px;
    }

    .chat-input {
      flex: 1;
      padding: 8px 12px;
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      color: var(--text-primary);
      font-size: 13px;
      outline: none;
    }

    .chat-input:focus { border-color: var(--accent-green); }

    .btn-send {
      padding: 8px 16px;
      background: var(--accent-green);
      color: #fff;
      border: none;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-send:hover { background: var(--accent-green-hover); }

    /* Action buttons */
    .action-buttons {
      display: flex;
      gap: 10px;
      margin-top: 20px;
    }

    .btn {
      flex: 1;
      padding: 10px 16px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 13px;
      cursor: pointer;
      transition: all 0.2s;
      border: none;
    }

    .btn-resign {
      background: var(--accent-red);
      color: #fff;
    }
    .btn-resign:hover { background: #d45546; }

    .btn-draw {
      background: var(--bg-tertiary);
      color: var(--text-secondary);
      border: 1px solid var(--border-color);
    }
    .btn-draw:hover {
      background: #454240;
      color: var(--text-primary);
    }

    /* Game popup */
    .game-popup-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.75);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      backdrop-filter: blur(4px);
    }

    .game-popup {
      background: var(--bg-card);
      border: 1px solid var(--border-light);
      border-radius: 16px;
      padding: 32px;
      max-width: 420px;
      width: 90%;
      text-align: center;
      box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    }

    .popup-icon {
      font-size: 64px;
      margin-bottom: 16px;
    }

    .popup-title {
      font-family: var(--font-heading);
      font-size: 28px;
      font-weight: 800;
      margin-bottom: 12px;
      color: var(--text-primary);
    }

    .popup-message {
      font-size: 16px;
      color: var(--text-secondary);
      margin-bottom: 24px;
      line-height: 1.5;
    }

    .popup-buttons {
      display: flex;
      gap: 12px;
    }

    .popup-btn {
      flex: 1;
      padding: 12px 20px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
      transition: all 0.2s;
      border: none;
    }

    .popup-btn-primary {
      background: var(--accent-green);
      color: #fff;
    }
    .popup-btn-primary:hover { background: var(--accent-green-hover); }

    .popup-btn-secondary {
      background: var(--bg-tertiary);
      color: var(--text-secondary);
      border: 1px solid var(--border-color);
    }
    .popup-btn-secondary:hover {
      background: #454240;
      color: var(--text-primary);
    }

    .hidden { display: none !important; }

    /* Notification */
    .notification {
      position: fixed;
      top: 20px;
      right: 20px;
      background: var(--bg-card);
      border: 1px solid var(--border-light);
      border-radius: 10px;
      padding: 16px 20px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.3);
      z-index: 2000;
      animation: slideIn 0.3s ease;
    }

    @keyframes slideIn {
      from { transform: translateX(400px); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }

    /* Responsive */
    @media (max-width: 1024px) {
      .sidebar { width: 320px; }
    }

    @media (max-width: 768px) {
      .game-container { flex-direction: column; }
      .sidebar {
        width: 100%;
        border-left: none;
        border-top: 1px solid var(--border-color);
        max-height: 40vh;
      }
      .main-area { padding: 12px; }
      .board-wrapper { max-width: 100%; }
      .piece { font-size: 6vw; }
    }
  </style>
</head>

<body>
  <div class="game-container">
    <!-- Main game area -->
    <div class="main-area">
      <div class="board-wrapper">
        <!-- Top player card -->
        <div class="player-card" id="topPlayerCard">
          <div class="player-info">
            <div class="player-avatar" id="topPlayerAvatar">⚫</div>
            <div class="player-details">
              <h3 id="topPlayerName">Waiting...</h3>
              <p id="topPlayerLabel">Opponent</p>
              <div class="player-captured-inline" id="topCaptured"></div>
            </div>
          </div>
          <div class="player-timer" id="topPlayerTimer">10:00</div>
        </div>

        <!-- Chessboard -->
        <div class="board-container">
          <div id="chessboard"></div>
        </div>

        <!-- Bottom player card -->
        <div class="player-card" id="bottomPlayerCard">
          <div class="player-info">
            <div class="player-avatar" id="bottomPlayerAvatar">⚪</div>
            <div class="player-details">
              <h3 id="bottomPlayerName">Waiting...</h3>
              <p id="bottomPlayerLabel">You</p>
              <div class="player-captured-inline" id="bottomCaptured"></div>
            </div>
          </div>
          <div class="player-timer" id="bottomPlayerTimer">10:00</div>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="sidebar">
      <!-- Top bar -->
      <div class="top-bar">
        <div class="room-info">
          <span style="color: var(--text-muted); font-size: 13px;">Room:</span>
          <div class="room-code" id="roomCode">------</div>
        </div>
        <button class="btn-copy" id="copyCodeBtn">📋 Copy</button>
      </div>

      <!-- Sidebar content -->
      <div class="sidebar-content">
        <!-- Move history -->
        <div class="section-title">Move History</div>
        <div class="move-history" id="moveHistory">
          <div style="color: var(--text-muted); font-size: 12px; text-align: center;">No moves yet</div>
        </div>

        <!-- Chat -->
        <div class="section-title">Chat</div>
        <div class="chat-container">
          <div class="chat-messages" id="chatMessages"></div>
          <div class="chat-input-area">
            <input type="text" class="chat-input" id="chatInput" placeholder="Type a message..." maxlength="200">
            <button class="btn-send" id="sendChatBtn">Send</button>
          </div>
        </div>

        <!-- Action buttons -->
        <div class="action-buttons">
          <button class="btn btn-resign" id="resignBtn">Resign</button>
          <button class="btn btn-draw" id="drawBtn">Offer Draw</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Game popup -->
  <div class="game-popup-overlay hidden" id="gamePopup">
    <div class="game-popup">
      <div class="popup-icon" id="popupIcon">🏆</div>
      <h2 class="popup-title" id="popupTitle">Game Over</h2>
      <p class="popup-message" id="popupMessage">The game has ended.</p>
      <div class="popup-buttons">
        <button class="popup-btn popup-btn-primary" id="newRoomBtn">New Game</button>
        <button class="popup-btn popup-btn-secondary" id="homeBtn">Home</button>
      </div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/chessgame.js"></script>
</body>
</html>
