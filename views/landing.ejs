<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Chess.com Clone — Play Chess Online</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-primary: #312e2b;
      --bg-secondary: #272522;
      --bg-tertiary: #3d3a37;
      --bg-card: #262421;
      --border-color: rgba(255,255,255,0.08);
      --border-light: rgba(255,255,255,0.12);
      --text-primary: #ffffff;
      --text-secondary: #b0b0b0;
      --text-muted: #8c8c8c;
      --accent-green: #81b64c;
      --accent-green-hover: #9bc35c;
      --accent-blue: #5d8aa8;
      --accent-red: #c44536;
      --accent-amber: #e3a02a;
      --font-heading: 'Montserrat', sans-serif;
      --font-body: 'Inter', sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      background-color: var(--bg-primary);
      font-family: var(--font-body);
      color: var(--text-primary);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow-x: hidden;
    }

    /* Subtle background pattern */
    body::before {
      content: '';
      position: fixed; inset: 0;
      background-image:
        radial-gradient(ellipse 50% 40% at 20% 20%, rgba(129,182,76,0.04) 0%, transparent 70%),
        radial-gradient(ellipse 50% 40% at 80% 80%, rgba(93,138,168,0.03) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    .landing-wrapper {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 480px;
      padding: 24px;
    }

    /* Top logo area */
    .landing-header {
      text-align: center;
      margin-bottom: 32px;
    }

    .landing-logo {
      width: 64px;
      height: 64px;
      margin: 0 auto 16px;
      background: var(--accent-green);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
      box-shadow: 0 4px 20px rgba(129,182,76,0.3);
    }

    .landing-header h1 {
      font-family: var(--font-heading);
      font-size: 28px;
      font-weight: 800;
      color: var(--text-primary);
      margin-bottom: 6px;
      letter-spacing: -0.5px;
    }

    .landing-header p {
      color: var(--text-muted);
      font-size: 15px;
      line-height: 1.5;
    }

    /* Card */
    .landing-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 32px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    }

    /* Name input */
    .input-label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-secondary);
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .room-input {
      width: 100%;
      padding: 14px 16px;
      border: 1px solid var(--border-color);
      border-radius: 10px;
      background: var(--bg-secondary);
      color: var(--text-primary);
      font-family: var(--font-body);
      font-size: 15px;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
      margin-bottom: 20px;
    }

    .room-input:focus {
      border-color: var(--accent-green);
      box-shadow: 0 0 0 3px rgba(129,182,76,0.15);
    }

    .room-input::placeholder { color: var(--text-muted); }

    .input-error {
      border-color: var(--accent-red) !important;
      box-shadow: 0 0 0 3px rgba(196,69,54,0.15) !important;
      animation: shake 0.3s ease;
    }

    @keyframes shake {
      0%,100% { transform: translateX(0); }
      25% { transform: translateX(-5px); }
      75% { transform: translateX(5px); }
    }

    .name-required-hint {
      font-size: 12px;
      color: var(--accent-red);
      margin-top: -16px;
      margin-bottom: 12px;
      display: none;
    }

    /* Divider */
    .divider {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 20px 0;
      color: var(--text-muted);
      font-size: 12px;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    .divider::before, .divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border-color);
    }

    /* Buttons */
    .btn {
      width: 100%;
      padding: 14px 20px;
      border-radius: 10px;
      font-family: var(--font-heading);
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.18s ease;
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-transform: none;
    }

    .btn-primary {
      background: var(--accent-green);
      color: #fff;
      box-shadow: 0 4px 12px rgba(129,182,76,0.3);
    }
    .btn-primary:hover {
      background: var(--accent-green-hover);
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(129,182,76,0.4);
    }
    .btn-primary:active { transform: translateY(0); }

    .btn-secondary {
      background: var(--bg-tertiary);
      color: var(--text-secondary);
      border: 1px solid var(--border-color);
    }
    .btn-secondary:hover {
      background: #454240;
      color: var(--text-primary);
      border-color: var(--border-light);
    }

    .btn-join-inline {
      padding: 14px 20px;
      white-space: nowrap;
      background: var(--accent-blue);
      color: #fff;
      font-size: 14px;
    }
    .btn-join-inline:hover {
      background: #6d9ab8;
      transform: translateY(-1px);
    }

    /* Join group */
    .join-group {
      display: flex;
      gap: 10px;
      margin-top: 10px;
    }
    .join-group .room-input {
      margin-bottom: 0;
      flex: 1;
      min-width: 0;
      height: 52px;
      font-size: 18px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 2px;
      text-align: center;
      font-family: var(--font-heading);
    }

    .hidden { display: none !important; }

    /* Footer */
    .landing-footer {
      text-align: center;
      margin-top: 24px;
      color: var(--text-muted);
      font-size: 13px;
    }

    /* Responsive */
    @media (max-width: 520px) {
      .landing-wrapper { padding: 16px; }
      .landing-card { padding: 24px; }
      .landing-header h1 { font-size: 24px; }
      .landing-logo { width: 56px; height: 56px; font-size: 28px; }
      .btn { padding: 12px 16px; font-size: 14px; }
      .join-group { flex-direction: column; }
      .join-group .btn-join-inline { width: 100%; }
      .join-group .room-input { font-size: 17px; }
    }
  </style>
</head>

<body>
  <div class="landing-wrapper">
    <div class="landing-header">
      <div class="landing-logo">♟️</div>
      <h1>Play Chess Online</h1>
      <p>Create a private room and challenge a friend</p>
    </div>

    <div class="landing-card">
      <label class="input-label">Your Name</label>
      <input type="text" class="room-input" id="playerNameInput" placeholder="Enter your name" maxlength="15" required>
      <div class="name-required-hint" id="nameHint">Please enter your name</div>

      <button class="btn btn-primary" id="createRoomBtn">
        <span>🎮</span> Create New Game
      </button>

      <div class="divider">or</div>

      <button class="btn btn-secondary" id="toggleJoinBtn">
        <span>🔗</span> Join Existing Room
      </button>

      <div class="join-group hidden" id="joinInputGroup">
        <input type="text" class="room-input" id="roomCodeInput" placeholder="ABC123" maxlength="6" autocomplete="off" spellcheck="false">
        <button class="btn btn-join-inline" id="joinRoomBtn">Join</button>
      </div>
    </div>

    <div class="landing-footer">
      Play chess with friends in real-time
    </div>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const createRoomBtn = document.getElementById('createRoomBtn');
    const toggleJoinBtn = document.getElementById('toggleJoinBtn');
    const joinInputGroup = document.getElementById('joinInputGroup');
    const joinRoomBtn = document.getElementById('joinRoomBtn');
    const roomCodeInput = document.getElementById('roomCodeInput');
    const playerNameInput = document.getElementById('playerNameInput');
    const nameHint = document.getElementById('nameHint');

    function validateName() {
      const name = playerNameInput.value.trim();
      if (!name) {
        playerNameInput.classList.add('input-error');
        nameHint.style.display = 'block';
        playerNameInput.focus();
        setTimeout(() => playerNameInput.classList.remove('input-error'), 400);
        return false;
      }
      playerNameInput.classList.remove('input-error');
      nameHint.style.display = 'none';
      return true;
    }

    playerNameInput.addEventListener('input', () => {
      if (playerNameInput.value.trim()) {
        playerNameInput.classList.remove('input-error');
        nameHint.style.display = 'none';
      }
    });

    createRoomBtn.addEventListener('click', async () => {
      if (!validateName()) return;
      const playerName = playerNameInput.value.trim();
      try {
        const response = await fetch('/api/create-room');
        const data = await response.json();
        if (data.roomId) {
          window.location.href = `/room/${data.roomId}?name=${encodeURIComponent(playerName)}`;
        }
      } catch (error) {
        console.error('Error creating room:', error);
        alert('Failed to create room. Please try again.');
      }
    });

    toggleJoinBtn.addEventListener('click', () => {
      joinInputGroup.classList.toggle('hidden');
      toggleJoinBtn.classList.toggle('hidden');
      if (!joinInputGroup.classList.contains('hidden')) {
        roomCodeInput.focus();
      }
    });

    joinRoomBtn.addEventListener('click', () => {
      if (!validateName()) return;
      const roomCode = roomCodeInput.value.trim().toUpperCase();
      const playerName = playerNameInput.value.trim();
      if (roomCode.length === 6) {
        window.location.href = `/room/${roomCode}?name=${encodeURIComponent(playerName)}`;
      } else {
        alert('Please enter a valid 6-character room code.');
      }
    });

    roomCodeInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') joinRoomBtn.click();
    });

    roomCodeInput.addEventListener('input', (e) => {
      e.target.value = e.target.value.toUpperCase();
    });
  </script>
</body>
</html>
